# Supabase (project byp-orders, ap-south-1). Server-only service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Payments — Razorpay TEST MODE only. Use rzp_test_… keys; live keys are refused.
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Local-only stub (PAYMENTS_PROVIDER=stub, refused in production). Never charges.
PAYMENTS_STUB_SECRET=

# Signed, expiring download links. Generate with: openssl rand -base64 48
DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_TTL_HOURS=72
DOWNLOAD_MAX_ATTEMPTS=5

# Email (receipts + delivery). Prefer Resend; SMTP is the fallback.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Site
NEXT_PUBLIC_SITE_URL=https://www.buildyourprojects.xyz
